{
  "name": "dangle-rush",
  "private": true,
  "version": "0.1.0",
  "description": "DangleRush MR – hokejový drill pre Meta Quest 3 (WebXR, passthrough, ovládanie pohľadom)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:usb": "vite --mode usb",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@iwer/devui": "^2.5.0",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "iwer": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@iwer/devui": {
      "three": "$three"
    }
  }
}
